{
  "name": "hamedkarbasi93-kafka-datasource",
  "version": "1.11.0",
  "description": "Kafka Datasource Plugin",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "build:backend": "mage build:backend && docker restart hamedkarbasi93-kafka-datasource",
    "build:producer-executable": "go build -C example/go -o ../../dist/producer .",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix && prettier --write --list-different .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "server": "docker compose up --build",
    "sign": "pnpm dlx @grafana/sign-plugin@latest",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Hamed Karbasi",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@grafana/eslint-config": "10.0.0",
    "@grafana/plugin-e2e": "3.15.4",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/core": "1.16.20",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "diagnostics-webpack-plugin": "1.1.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "intersection-observer": "0.12.2",
    "jest": "30.5.2",
    "jest-canvas-mock": "2.5.8",
    "jest-environment-jsdom": "30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "3.9.10",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.107.0",
    "sass-loader": "17.1.0",
    "semver": "7.8.5",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.0",
